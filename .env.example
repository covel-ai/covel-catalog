# Copy to .env and configure for a chosen host. No resources are created by this file.
CATALOG_PUBLIC_URL=https://api.covel.cc
CATALOG_ALLOWED_ORIGINS=https://plugins.covel.cc,https://worlds.covel.cc
# Supply three distinct secrets through your deployment secret manager (32+ characters).
CATALOG_PLUGINS_TOKEN=
CATALOG_WORLDS_TOKEN=
CATALOG_POLICY_TOKEN=
GITHUB_TOKEN=
GITHUB_REQUEST_BUDGET=4500
# Per socket address per minute. A reverse proxy shares one bucket; tune with edge limits.
CATALOG_RATE_LIMIT=180
